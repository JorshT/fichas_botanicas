# Copiar a .env.local y completar. Nunca subir .env.local a GitHub.

# Supabase → Project Settings → API (o "Data API")
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Clave secreta: "service_role" (legacy) o "secret key" (sb_secret_...). ¡Solo servidor!
SUPABASE_SERVICE_ROLE_KEY=

# Cadena aleatoria larga; Vercel la usa para autenticar el cron diario.
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# URL pública de la app (se usa para imprimir los links en los scripts).
APP_URL=http://localhost:3000
